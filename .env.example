NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sprite_generator
REDIS_URL=redis://localhost:6379
FAL_KEY=
AI_PROVIDER=pixellab
FAL_MODEL=sprite
PIXELLAB_API_TOKEN=
PIXELLAB_BASE_URL=https://api.pixellab.ai/v2
PIXELLAB_POLL_INTERVAL_MS=2500
PIXELLAB_JOB_TIMEOUT_MS=180000
AI_AUTO_RETRY_PAID_OUTPUT=false
WORKER_CONCURRENCY=2
RESULT_STORAGE_PATH=artifacts/backend-results
SPRITE_TEMP_PATH=artifacts/runtime-temp
PUBLIC_API_URL=http://localhost:3000
API_KEY_PEPPER=replace-with-at-least-32-random-characters
